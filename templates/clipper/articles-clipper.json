{
	"schemaVersion": "0.1.0",
	"name": "Articles",
	"behavior": "create",
	"noteContentFormat": "# {{title}}\n\n## Concepts\n```dataview\nTABLE WITHOUT ID \n    link(file.link, default(aliases[0], file.name)) as \"Name\",\n    \"Weight: \" + default(length(file.inlinks), 0) as \"Weight\"\nFROM #📖 \nWHERE contains(referenced-in, this.file.link)\nSORT default(length(file.inlinks), 0) DESC\n```\n\n>[!summary]- Description\n> {{schema:description}}\n\n## Content\n\n{{content}}",
	"properties": [
		{
			"name": "tags",
			"value": "📰",
			"type": "multitext"
		},
		{
			"name": "create-date",
			"value": "[[{{date|date:\\\"YYYY-MM-DD\\\"}}]]",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\\\", \\\"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "[[{{published|date:\\\"YYYY-MM-DD\\\"}}]]",
			"type": "text"
		},
		{
			"name": "cssClasses",
			"value": "cards, cards-cols-4",
			"type": "multitext"
		},
		{
			"name": "dg-publish",
			"value": "",
			"type": "checkbox"
		},
		{
			"name": "modified-dates",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "maps",
			"value": "",
			"type": "multitext"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title}}",
	"path": "read-it-later"
}