{
	"schemaVersion": "0.1.0",
	"name": "Articles",
	"behavior": "create",
	"noteContentFormat": ">[!summary]- Description\n> {{schema:description}}\n\n# {{title}}\n\n## Content\n\n{{content}}",
	"properties": [
		{
			"name": "tags",
			"value": "📰",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "authors",
			"value": "{{\\\"the author(s) of this article — return only human names as a comma-separated list, no URLs or organizations\\\"|split:\\\", \\\"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "[[{{published|date:\\\"YYYY-MM-DD\\\"}}]]",
			"type": "text"
		},
		{
			"name": "cssClasses",
			"value": "cards, cards-cols-4",
			"type": "multitext"
		},
		{
			"name": "dg-publish",
			"value": "",
			"type": "checkbox"
		},
		{
			"name": "create-date",
			"value": "[[{{date|date:\\\"YYYY-MM-DD\\\"}}]]",
			"type": "text"
		},
		{
			"name": "related",
			"value": "{{meta:name:keywords|split:\\\", \\\"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "parent",
			"value": "",
			"type": "text"
		},
		{
			"name": "modified-dates",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "append_modified_update",
			"value": "true",
			"type": "checkbox"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title}}",
	"path": "inbox"
}