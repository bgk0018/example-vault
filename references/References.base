filters:
  and:
    - file.inFolder("references")
    - file.ext == "md"
views:
  - type: table
    name: By Type
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - parent
      - create-date
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 400
      note.parent: 300
  - type: table
    name: Recent
    order:
      - file.name
      - tags
      - parent
      - create-date
    sort:
      - property: create-date
        direction: DESC
    columnSize:
      file.name: 400
      file.tags: 150
      note.parent: 250
